    },
    {
      "text": "huur en lease.",
      "startSec": 49.5,
      "endSec": 50.28,
      "style": "minimal",
      "position": 0.78,
      "fontSizePx": 47
    },
    {
      "text": "Met 203 miljoen aan overige inkomsten komt",
      "startSec": 50.68,
      "endSec": 53.23,
      "style": "minimal",
      "position": 0.78,
      "fontSizePx": 47
    },
    {
      "text": "de omzet uit op 2,761 miljard euro.",
