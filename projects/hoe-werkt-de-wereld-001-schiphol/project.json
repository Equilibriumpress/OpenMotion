      "endSec": 55.78,
      "style": "minimal",
      "position": 0.78,
      "fontSizePx": 47
    },
    {
      "text": "Ruim twee derde komt uit havengelden. De",
      "startSec": 56.18,
      "endSec": 59.195,
      "style": "minimal",
      "position": 0.78,
      "fontSizePx": 47
    },
    {
      "text": "rest uit commerciële en andere activiteiten.",
      "startSec": 59.195,
      "endSec": 61.78,
      "style": "minimal",
      "position": 0.78,
      "fontSizePx": 47
    },
    {
      "text": "Omzet is geen winst. Je betaalt direct",
