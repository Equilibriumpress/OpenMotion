      "durationSec": 14,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "Not everyone finishes",
      "subheadline": "2025 edition / 2,492 starters.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 5
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "In the twenty twenty-five edition, according to the reference, two thousand four hundred and ninety-two runners started. Eight hundred and twenty-nine did not finish. Nearly one third of the field stopped before reaching Chamonix."
      }
    },
    {
      "id": "shot-7",
      "name": "One loop around Mont Blanc",
      "durationSec": 15,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "One loop around Mont Blanc",
      "subheadline": "Three countries / 170 km / about 10,000 m up.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 6
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "One circuit of the massif. Three countries. Around ten thousand metres of cumulative ascent. The race ends at its starting point, and the summit of Mont Blanc is never part of the route. This is the scale of the UTMB."
      }
    }
