      "id": "shot-1",
      "name": "Around the giant",
      "durationSec": 15,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "Around the giant",
      "subheadline": "Mont Blanc / 4,800+ m above sea level.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 0
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "Mont Blanc rises more than four thousand eight hundred metres above sea level. Every summer, runners gather beneath it for a race that does not take them to the summit. Instead, they travel all the way around the massif."
      }
    },
    {
      "id": "shot-2",
      "name": "One loop, three countries",
      "durationSec": 19,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "One loop, three countries",
      "subheadline": "Around 170 km / France → Italy → Switzerland.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 1
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "From Chamonix, the course heads through the French valleys and over Alpine passes into Italy. From Courmayeur it continues towards Switzerland, before turning back into France. Around one hundred and seventy kilometres bring the runners back to the town where they began."
      }
    },
    {
      "id": "shot-3",
      "name": "The climbs keep coming",
      "durationSec": 17,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "The climbs keep coming",
      "subheadline": "Checkpoint elevations across the massif.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 2
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "Look at the elevations along the route. Runners descend into valleys and then climb towards the passes. They repeat this sequence throughout the race. This diagram connects approximate checkpoint elevations, rather than showing every rise and fall of the actual course."
      }
    },
    {
      "id": "shot-4",
      "name": "More climbing than Everest",
      "durationSec": 15,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "More climbing than Everest",
      "subheadline": "Cumulative ascent is not the same as elevation.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 3
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "The climbs add up to roughly ten thousand metres of ascent. Mount Everest stands eight thousand eight hundred and forty-nine metres above sea level. The comparison shows how much climbing runners accumulate, even though no point on this course reaches that height."
      }
    },
    {
      "id": "shot-5",
      "name": "Through the night",
      "durationSec": 16,
      "layout": "three-explainer",
      "transition": "fade",
      "backdrop": "radial-studio",
      "headline": "Through the night",
      "subheadline": "The race continues after sunset.",
      "fullBleed": true,
      "threeExplainer": {
        "kind": "utmb",
        "shot": 4
      },
      "doodle": {
        "setting": "standing",
        "palette": "night",
        "mood": "relaxed",
        "extras": [
          "mind-series-v1"
        ],
        "narration": "The race begins in the evening. For runners who spend close to the time limit on the course, darkness falls twice. The temperature, visibility and terrain change while the distance remaining steadily decreases. The mountain is still there when the sun returns."
      }
    },
    {
      "id": "shot-6",
